<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tsh.d94</groupId>
        <artifactId>d94-lib-pom</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../lib/d94-lib-pom/pom.xml</relativePath>
    </parent>

    <groupId>tsh.d94</groupId>
    <artifactId>d94.app.query</artifactId>
    <packaging>jar</packaging>
    <name>d94-query</name>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <module-name>d94</module-name>
        <service-name>app-server</service-name>

        <d94-lib-core>1.0.0-SNAPSHOT</d94-lib-core>
        <d94-lib-data>1.0.0-SNAPSHOT</d94-lib-data>
    </properties>

    <dependencies>


        <dependency>
            <groupId>tsh.d94</groupId>
            <artifactId>d94-lib-core</artifactId>
            <version>${d94-lib-core}</version>
        </dependency>

        <dependency>
            <groupId>tsh.d94</groupId>
            <artifactId>d94-lib-data</artifactId>
            <version>${d94-lib-data}</version>
        </dependency>


        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- MinIO S3 Storage -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.7</version>
        </dependency>
    </dependencies>


    <!--
        d94-query는 별도 GitHub 저장소라 로컬 relativePath(../../lib/d94-lib-pom/pom.xml)로 parent를
        찾지 못하는 경우(CI 등) GitHub Packages에서 parent pom과 d94-lib-core를 내려받습니다.
    -->
    <repositories>
        <repository>
            <id>github-d94</id>
            <url>https://maven.pkg.github.com/david-yj-52/d94-lib-pom</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
        <repository>
            <id>github-lib-core</id>
            <url>https://maven.pkg.github.com/david-yj-52/d94-lib-core</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
        <repository>
            <id>github-lib-data</id>
            <url>https://maven.pkg.github.com/david-yj-52/d94-lib-data</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>  <!-- ??異붽? -->
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>   <!-- 理쒖떊 踰꾩쟾 異붿쿇 -->
                <configuration>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                </configuration>
            </plugin>

            <!-- spring-boot-maven-plugin???덉쑝硫?醫뗭쓬 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <compilerArgs>--enable-preview</compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

