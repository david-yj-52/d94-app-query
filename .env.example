# 사용법: 이 파일을 .env로 복사 후 값 채우기
#   cp .env.example .env
# .env는 절대 git에 커밋하지 말 것 (.gitignore에 이미 포함됨)

# ── 이미지 ──────────────────────────────────────────
# ghcr.io/david-yj-52/d94-query 의 태그. latest / v1.0.0 / sha-xxxxxxx 등
IMAGE_TAG=latest
# 호스트에서 접속할 포트
APP_PORT=8080

# ── 공유 네트워크 ────────────────────────────────────
# db/messaging을 관리하는 별도 docker compose와 컨테이너 이름으로 통신하려면
# 두 compose가 같은 external network를 써야 함.
# 최초 1회: docker network create d94-shared
# (db/messaging 쪽 compose 파일에도 동일한 network를 external로 붙여줄 것)
SHARED_NETWORK_NAME=d94-shared

# ── DB (Postgres, 필수) ─────────────────────────────
# 같은 shared network를 쓰는 postgres 컨테이너 이름, 또는 접근 가능한 host/IP
DB_HOST=postgres
DB_PORT=5432
DB_NAME=d94
DB_USERNAME=d94
DB_PASSWORD=change-me

# ── Redis ───────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# simple(기본, 인메모리) 또는 redis
CACHE_TYPE=simple

# ── 인증 ────────────────────────────────────────────
# 운영에서는 반드시 직접 발급한 값으로 교체할 것 (기본값은 개발용)
JWT_SECRET_KEY=change-me-to-a-real-secret
# CORS 허용 origin. 콤마 구분 또는 *
NEXT_PUBLIC_URL=*

# ── MinIO (첨부파일 스토리지) ────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cira-attachments
MINIO_REGION=ap-northeast-2

# ── 메시징 ──────────────────────────────────────────
# 아래 enable 플래그를 true로 켜도, 실제 접속 정보(host/port/계정)는
# 코드가 아니라 DB(GS_MSG_SRV_CONN 테이블)에서 읽어옵니다.
# 즉 true로 켜기 전에 해당 솔루션의 연결 정보 row가 DB에 먼저 등록돼 있어야
# "Not found messaging server info" 에러 없이 기동됩니다.
# (RabbitMQ의 경우 host는 위 SHARED_NETWORK_NAME 상의 컨테이너 이름, 예: rabbitmq)
SOLACE_ENABLE=false
SOLACE_SEMP_CREDENTIAL=
KAFKA_ENABLE=false
RABBITMQ_ENABLE=false
